<?xml version="1.0" encoding="utf-8"?>
<!--
  Format views for the public PSTypeName shapes.
-->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Mcp.Session</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.Session</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Kind</Label><Width>9</Width></TableColumnHeader>
          <TableColumnHeader><Label>ProtocolVersion</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Closed</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>Endpoint</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Kind</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ProtocolVersion</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Closed</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Endpoint</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Mcp.ServerInfo</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.ServerInfo</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Name</PropertyName></ListItem>
              <ListItem><PropertyName>Version</PropertyName></ListItem>
              <ListItem><PropertyName>Title</PropertyName></ListItem>
              <ListItem><PropertyName>ProtocolVersion</PropertyName></ListItem>
              <ListItem><Label>SupportedVersions</Label><ScriptBlock>$_.SupportedVersions -join ', '</ScriptBlock></ListItem>
              <ListItem><Label>Capabilities</Label><ScriptBlock>if ($_.Capabilities) { @($_.Capabilities.Keys) -join ', ' }</ScriptBlock></ListItem>
              <ListItem><PropertyName>Instructions</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>Mcp.Tool</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.Tool</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap />
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Mcp.ToolResult</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.ToolResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>ToolName</PropertyName></ListItem>
              <ListItem><PropertyName>IsError</PropertyName></ListItem>
              <ListItem><PropertyName>Text</PropertyName></ListItem>
              <ListItem><Label>Content</Label><ScriptBlock>@($_.Content | ForEach-Object { $_.type }) -join ', '</ScriptBlock></ListItem>
              <ListItem><Label>StructuredContent</Label><ScriptBlock>if ($null -ne $_.StructuredContent) { $_.StructuredContent | ConvertTo-Json -Compress -Depth 20 }</ScriptBlock></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>Mcp.Resource</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.Resource</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Uri</Label></TableColumnHeader>
          <TableColumnHeader><Label>MimeType</Label><Width>24</Width></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Uri</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MimeType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Mcp.ResourceTemplate</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.ResourceTemplate</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>UriTemplate</Label></TableColumnHeader>
          <TableColumnHeader><Label>MimeType</Label><Width>24</Width></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>UriTemplate</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MimeType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Mcp.ResourceContent</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.ResourceContent</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Uri</Label></TableColumnHeader>
          <TableColumnHeader><Label>MimeType</Label><Width>24</Width></TableColumnHeader>
          <TableColumnHeader><Label>Content</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Uri</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MimeType</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.Text) { $_.Text } elseif ($null -ne $_.Blob) { "(" + [System.Convert]::FromBase64String([string] $_.Blob).Length + " bytes)" }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Mcp.Prompt</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.Prompt</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Arguments</Label></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.Arguments | ForEach-Object { if ($_.Required) { $_.Name } else { "[" + $_.Name + "]" } }) -join ", "</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Mcp.PromptResult</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.PromptResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Name</PropertyName></ListItem>
              <ListItem><PropertyName>Description</PropertyName></ListItem>
              <ListItem><Label>Messages</Label><ScriptBlock>@($_.Messages | ForEach-Object { $_.Role + ": " + $(if ($_.Content.type -eq "text") { $_.Content.text } else { "(" + $_.Content.type + ")" }) }) -join [System.Environment]::NewLine</ScriptBlock></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>Mcp.Completion</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.Completion</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><Label>Values</Label><ScriptBlock>$_.Values -join ", "</ScriptBlock></ListItem>
              <ListItem><PropertyName>Total</PropertyName></ListItem>
              <ListItem><PropertyName>HasMore</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>Mcp.Subscription</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.Subscription</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>State</Label></TableColumnHeader>
          <TableColumnHeader><Label>Honoured</Label></TableColumnHeader>
          <TableColumnHeader><Label>Queued</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.Honoured) { @(foreach ($key in $_.Honoured.Keys) { if ($key -eq 'resourceSubscriptions') { @($_.Honoured[$key]) -join ', ' } else { $key } }) -join ', ' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Notifications.Count</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Mcp.Notification</Name>
      <ViewSelectedBy>
        <TypeName>Mcp.Notification</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Received</Label></TableColumnHeader>
          <TableColumnHeader><Label>Method</Label></TableColumnHeader>
          <TableColumnHeader><Label>Uri</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>$_.Received.ToLocalTime().ToString("HH:mm:ss")</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Method</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Uri</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
